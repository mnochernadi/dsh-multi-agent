# ---------------------------------------------------------------------------
# dsh-multi-agent — dashboard configuration (all optional)
#
# Copy this file to `.env` and edit. Every value can also be changed at runtime
# from the dashboard's Settings panel, which writes `.dsh-multi-agent/settings.json`.
# Precedence: environment variable > settings.json > built-in default.
#
# NOTE ON API KEYS
#   This file is intentionally NOT where provider API keys belong. Each agent is
#   executed by a real `dsh` process, so credentials resolve exactly the way DSH
#   resolves them for any other surface: the launch environment, then
#   `<run cwd>/.env`, then `$DSH_HOME/.env`, then — when stored credentials are
#   trusted — the credential store your DSH app already uses.
#   Keep secrets in DSH's own store. Nothing here is ever sent to a browser.
# ---------------------------------------------------------------------------

# Web server bind address and port.
DSH_MA_DASHBOARD_HOST=127.0.0.1
DSH_MA_DASHBOARD_PORT=7317

# Path to the `dsh` launcher. Leave empty to auto-detect (PATH, then the
# standard DeepSeek Harness installation directories).
#   Windows: C:\Users\<you>\AppData\Local\Programs\DeepSeek Harness\resources\runtime\cli\bin\dsh.cmd
#   macOS:   /Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh
#   Linux:   ~/.local/share/deepseek-harness/resources/runtime/cli/bin/dsh
DSH_MA_DSH_BIN=

# DSH home directory (profiles, credentials, sessions). Leave empty to inherit
# the DSH_HOME of the environment that starts the dashboard.
DSH_MA_DSH_HOME=

# Working directory given to every agent run. Leave empty to use a
# per-run workspace under .dsh-multi-agent/workspaces/.
DSH_MA_RUN_CWD=

# Per-agent wall-clock timeout in milliseconds (0 disables the timeout).
DSH_MA_RUN_TIMEOUT_MS=1800000

# Upper bound for agents running at the same time.
DSH_MA_MAX_CONCURRENCY=4

# Re-enable DSH's managed credential store inside agent runs, so that sign-ins
# and API keys saved by the DeepSeek Harness app are available to headless runs.
DSH_MA_TRUST_STORED_CREDENTIALS=true

# Default UI language: fa (Persian, RTL) or en (English, LTR).
DSH_MA_LANGUAGE=fa
